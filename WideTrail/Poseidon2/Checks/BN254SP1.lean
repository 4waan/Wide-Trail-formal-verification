`sp1-recursion-gnark-ffi` `6.10.0` `go/sp1/poseidon2/poseidon2_test.go:44-46`. -/
theorem sp1_gnark_vector : permutation ![0, 0, 0] =
    ![0x2ED1DA00B14D635BD35B88AB49390D5C13C90DA7E9E3A5F1EA69CD87A0AA3E82,
      0x1E21E979CC3FD844B88C2016FD18F4DB07A698AA27DECA67CA509F5B0A4480D0,
      0x2C40D0115DA2C9B55553B231BE55295F411E628ED0CD0E187917066515F0A060] := by
  unfold permutation
  apply Eq.trans (execute_trace 64 (by decide))
  decide

