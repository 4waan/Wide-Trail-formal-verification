/-- `zeroTrace`, extended by `0` past the last round. -/
def trace (n : Nat) : State := if h : n < 65 then zeroTrace ⟨n, h⟩ else 0

theorem trace_start : trace 0 = external ![0, 0, 0] := by decide

set_option maxHeartbeats 8000000 in
-- `decide` reduces sixty-four rounds of 254-bit arithmetic in the kernel.
/-- Each of the `64` transitions is checked once, avoiding nested execution reduction. -/
theorem round_step : ∀ n : Fin 64, (rounds n.val).apply (trace n.val) = trace (n.val + 1) := by
  decide

theorem execute_trace (n : Nat) (hn : n ≤ 64) :
    Hades.execute rounds (external ![0, 0, 0]) n = trace n := by
  induction n with
  | zero => exact trace_start.symm
  | succ n ih =>
    rw [Hades.execute_succ, ih (by omega)]
    exact round_step ⟨n, by omega⟩

