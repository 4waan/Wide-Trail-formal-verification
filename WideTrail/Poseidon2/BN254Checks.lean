def trace (n : Nat) : State := if h : n < 65 then katTrace ⟨n, h⟩ else 0

theorem kat_start : trace 0 = external ![0, 1, 2] := by decide

set_option maxHeartbeats 8000000 in
-- Each of the 64 transitions is checked once, avoiding nested execution reduction.
theorem kat_step : ∀ n : Fin 64, (rounds n.val).apply (trace n.val) = trace (n.val + 1) := by
  decide

theorem execute_trace (n : Nat) (hn : n ≤ 64) :
    Hades.execute rounds (external ![0, 1, 2]) n = trace n := by
  induction n with
  | zero => exact kat_start.symm
  | succ n ih =>
    rw [Hades.execute_succ, ih (by omega)]
    exact kat_step ⟨n, by omega⟩

theorem reference_vector : permutation ![0, 1, 2] =
    ![0xbb61d24daca55eebcb1929a82650f328134334da98ea4f847f760054f4a3033,
      0x303b6f7c86d043bfcbcc80214f26a30277a15d3f74ca654992defe7ff8d03570,
      0x1ed25194542b12eef8617361c3ba7c52e660b145994427cc86296242cf766ec8] := by
  unfold permutation
  apply Eq.trans (execute_trace 64 (by decide))
  decide

end Poseidon2.BN254.Checks
