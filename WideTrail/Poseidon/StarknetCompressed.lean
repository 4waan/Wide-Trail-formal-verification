import WideTrail.Poseidon.Starknet
import WideTrail.Poseidon.ConstantFolding

/-!
# The compressed constants define the same permutation

Most deployed implementations of Starknet's Poseidon do not run the loop of cairo-lang. They use
`107` compressed constants: in a partial round they add one constant to coordinate `2` only, and
the first round of the last full block uses modified constants that absorb the constants of
coordinates `0` and `1` of the partial rounds, pushed forward through the linear layer. These
are `POSEIDON_COMP_CONSTS` of starknet-crypto `≤ 0.7.1` (generated by starknet-crypto-codegen
`0.3.3` `src/poseidon/mod.rs:38-94`), `permute_comp` of eqlabs/pathfinder commit
`00a1a74a90a7b8a7f1d07ac3e616be1cb39cf8f1` (`crates/stark_poseidon/src/poseidon.rs:61-98`), and
`OPTIMIZED_ROUND_CONSTANTS` of lambdaworks-crypto `0.13.0`
(`src/hash/poseidon/starknet/parameters.rs:340-446`, read by `src/hash/poseidon/mod.rs:27-57`),
which starknet-types-core, starknet-crypto `≥ 0.7.2` and cairo-vm use.

## The compressed schedule

`compressedValues` reads `compressedConstants` with the index stepping of lambdaworks-crypto
`0.13.0` `src/hash/poseidon/mod.rs:27-41`: three entries per full round, one per partial round.
Row `n` is `(c[3n], c[3n+1], c[3n+2])` for `n < 4`, `(0, 0, c[12 + (n - 4)])` for
`4 ≤ n < 87`, and `(c[95 + 3(n - 87)], …)` for `87 ≤ n < 91`. lambdaworks-crypto `0.13.0`
declares `N_ROUND_CONSTANTS_ROWS = 91` and `N_ROUND_CONSTANTS_COLS = 3`
(`src/hash/poseidon/starknet/parameters.rs:21-22`) while pointing `ROUND_CONSTANTS` at the
`107`-entry table; the table is consistent only with this index stepping.

`compressedPermutation` is the HADES schedule with this table, the same masks, S-box and linear
layer as `permutation`, and no initial layer. A partial round of it adds `c[12 + (n - 4)]` to
coordinate `2` only (`compressedRounds_apply_partial`), as lambdaworks-crypto `0.13.0`
`src/hash/poseidon/mod.rs:53-57` does.

## Results

* `compressedPermutation_eq`: **for every input `x`, `compressedPermutation x = permutation x`.**
  The proof is `Poseidon.hadesSchedule_execute_eq_of_fold` with the offsets `foldOffsets`, the
  difference between the two schedules' states at the input of each round, computed outside
  Lean; the conditions of the folding lemma (`foldOffset_zero`, `foldOffset_end`,
  `fold_mask_zero`, `fold_next`) are checked by `decide` (`decide +kernel` for the last two,
  which keeps the peak memory of this file lower).
* `keyed_compressed_eq`: **for every key sequence `k` and every input `x`, the schedules with
  the tables `compressedValues n + k n` and `values n + k n` compute the same state after `91`
  rounds.** The folding conditions involve the two tables only through
  `values n - compressedValues n`, which adding the same `k n` to both leaves unchanged, so the
  same offsets `foldOffset` work.
* `keyCount_compressed_eq`: the trail count `Hades.keyCount` of the independent-key model is the
  same for `compressedRounds` and `rounds`, for every number of rounds, trail and input; by
  `Hades.keyCount_eq_prod` it involves only the masks, S-boxes and linear layers.
* `compressed_partial_constants_zero`: rows `4` to `86` of the compressed table are zero off
  coordinate `2`, the analogue of `Poseidon2.BN254.partial_constants_zero`, which is false for
  the unoptimised table (`Checks/Starknet.lean`, `values_partial_ne_zero`).
* `compressedValues_eq_values_full`: the compressed rows of the full rounds other than round `87`
  are the rows of `roundConstants`; `compressedValues_ne_values_87`: row `87` differs;
  `compressedValues_ne_values_partial`: in each partial round from round `5` to round `86`, the
  constant added at coordinate `2` differs between the two tables (`compressedValues_ne_values_5`
  is round `5`); `compressedValues_eq_values_4`: in round `4`, the first partial round, it is the
  same. So the two tables cannot be mixed: each must be read with its own schedule.

## What is not claimed

These results identify functions and counts; they say nothing about the code beyond the index
stepping cited above. The independent-key statements of `WideTrail.Poseidon.Starknet` have
`_general` forms for every table, so they also hold for this one; beyond those, nothing is
stated here about the differential count `Hades.diffKeyCount` of the compressed schedule.
-/

set_option autoImplicit false
-- `decide` unfolds the literal tables, which needs more than the default depth.
set_option maxRecDepth 16000

namespace Poseidon.Starknet

/-- Entry `k` of the compressed table, zero past entry `106`. -/
def compressed (k : ℕ) : F := if h : k < 107 then compressedConstants ⟨k, h⟩ else 0

/-- **Row `n` of the compressed schedule**, read with the index stepping of lambdaworks-crypto
`0.13.0` `src/hash/poseidon/mod.rs:27-41`: three entries per full round, one entry, at
coordinate `2`, per partial round. -/
def compressedValues (n : ℕ) : State :=
  if n < 4 then ![compressed (3 * n), compressed (3 * n + 1), compressed (3 * n + 2)]
  else if n < 87 then ![0, 0, compressed (12 + (n - 4))]
  else if n < 91 then
    ![compressed (95 + 3 * (n - 87)), compressed (95 + 3 * (n - 87) + 1),
      compressed (95 + 3 * (n - 87) + 2)]
  else 0

/-- The compressed rounds: the masks, S-box and linear layer of `rounds`, the table
`compressedValues`. -/
def compressedRounds : ℕ → Hades.RoundSpec (Fin 3) F :=
  Hades.hadesSchedule 4 83 4 {2} (fun _ _ => sbox) (fun _ => mds) compressedValues

/-- The permutation of the compressed schedule, with no initial layer. -/
def compressedPermutation (x : State) : State := Hades.execute compressedRounds x 91

/-- **A partial round of the compressed schedule adds one constant, to coordinate `2`**
(lambdaworks-crypto `0.13.0` `src/hash/poseidon/mod.rs:53-57`), cubes coordinate `2` and applies
`M`. -/
theorem compressedRounds_apply_partial {n : ℕ} (h1 : 4 ≤ n) (h2 : n < 87) (x : State) :
    (compressedRounds n).apply x =
      mds (Function.update x 2 (sbox (x 2 + compressed (12 + (n - 4))))) := by
  obtain ⟨j, rfl⟩ : ∃ j, n = 4 + j := ⟨n - 4, by omega⟩
  simp only [compressedRounds, Hades.hadesSchedule, Hades.RoundSpec.apply,
    Hades.hadesMask_middle 4 83 4 _ (show j < 83 by omega), Hades.maskedEquiv_apply]
  congr 1
  funext i
  have hv : compressedValues (4 + j) = ![0, 0, compressed (12 + (4 + j - 4))] := by
    simp [compressedValues, show ¬(4 + j < 4) by omega, show 4 + j < 87 by omega]
  rw [hv]
  fin_cases i <;> simp [Matrix.vecHead, Matrix.vecTail]

/-- **Rows `4` to `86` of the compressed table are zero off coordinate `2`.** -/
theorem compressed_partial_constants_zero :
    ∀ n : Fin 83, ∀ i : Fin 3, i ≠ 2 → compressedValues (4 + n.val) i = 0 := by
  decide

/-- The compressed rows of rounds `0` to `3` and `88` to `90` are those of `roundConstants`. -/
theorem compressedValues_eq_values_full :
    ∀ n : Fin 91, (n.val < 4 ∨ 88 ≤ n.val) → compressedValues n.val = values n.val := by
  decide

/-- Row `87` of the compressed table is not row `87` of `roundConstants`. -/
theorem compressedValues_ne_values_87 : compressedValues 87 ≠ values 87 := by
  decide

/-- **In every partial round from round `5` to round `86`, the constant added at coordinate `2`
differs between the two tables.** Round `4`, the first partial round, is the exception
(`compressedValues_eq_values_4`). -/
theorem compressedValues_ne_values_partial :
    ∀ n : Fin 82, compressedValues (5 + n.val) 2 ≠ values (5 + n.val) 2 := by
  decide

/-- In round `5`, the constant added at coordinate `2` differs between the two tables (the case
`n = 0` of `compressedValues_ne_values_partial`). -/
theorem compressedValues_ne_values_5 : compressedValues 5 2 ≠ values 5 2 :=
  compressedValues_ne_values_partial 0

/-- The coordinate-`2` constant of round `4`, the first partial round, is the same in both
tables. -/
theorem compressedValues_eq_values_4 : compressedValues 4 2 = values 4 2 := by
  decide

/-- **The folding offsets** `δ n`, `n ≤ 91`: the state of `permutation` minus the state of
`compressedPermutation` at the input of round `n`, for every input. They do not depend on the
input. Computed outside Lean; the conditions of the folding lemma are checked by `fold_mask_zero`
and `fold_next`. -/
