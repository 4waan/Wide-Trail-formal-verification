import WideTrail.Propagation.FourRound

/-!
# Bundled wide-trail specifications and multi-round bounds

`WideTrailSpec` packages everything a `γπθ` cipher must supply for the four-round bound
the column partition, an S-box layer, a dispersion permutation, a mixing layer, and the
four structural facts about them. Instantiating the structure and reading off
`fourRoundBound` is the "kernel-checked active-S-box bound" the project is aiming at:
the number is `B²`, and the proof obligation is discharged once, here.

`trailWeight_bound` then extends the paper, which only remarks that "any `2n`-round trail
can be decomposed in `n` 2-round trails". The same decomposition at width four gives
`n · B²` active S-boxes over `4n` rounds.

All of it is stated for an `IsTrail` sequence: a sequence of difference patterns in which
consecutive entries are related by the linear layer applied to *some* pattern carrying the
current support. That is what a real S-box layer supplies, and no more. The functional
`trail` generated by `sbox` is one such sequence, so the familiar statements are corollaries
of the general ones rather than a parallel development.

`trailWeight_bound_add_two` then recovers the rounds that tiling throws away. A `4n + k`
round trail is `n` four-round blocks plus a tail of `k < 4` rounds, and if `k ≥ 2` that
tail still contains a two-round block, which Theorem 1 charges `B` for. The blocks and
the tail occupy disjoint rounds, so the counts add: `n · B² + B`. AES-128 has 10 rounds,
which is two four-round blocks *and* a two-round tail, hence `2 · 25 + 5 = 55` rather
than the `50` that discarding the tail gives.
-/

set_option autoImplicit false

/-- A cipher in the `γπθ` shape, together with the structural facts the wide-trail
theorems consume. -/
structure WideTrailSpec (Idx Col K : Type*) [Zero K] [DecidableEq K] [Fintype Idx]
    [DecidableEq Idx] [DecidableEq Col] [Fintype Col] where
  /-- The column partition, given by its quotient map. -/
  col : Idx → Col
  /-- The non-linear bricklayer layer `γ`. -/
  sbox : (Idx → K) → (Idx → K)
  /-- The bundle transposition underlying the dispersion layer `π`. -/
  disp : Equiv.Perm Idx
  /-- The intra-column mixing layer `θ`. -/
  mix : (Idx → K) → (Idx → K)
  /-- The bundle branch number of `θ`. -/
  branch : Nat
  /-- `γ` is a bricklayer of invertible S-boxes, so it moves no activity. -/
  sbox_preserves : PreserveSupport sbox
  /-- `π` scatters each column across pairwise distinct columns. -/
  disp_optimal : DiffusionOptimal col disp
  /-- Every column active on either side of `θ` carries `branch` active bundles. -/
  mix_branch : IsColBranchBound col mix branch
  /-- `θ` is invertible. -/
  mix_nondeg : NonDegenerate mix

section PatternWeight

variable {Idx K : Type*} [Zero K] [DecidableEq K] [Fintype Idx]

/-- The bundle weight of the first `r` patterns of a sequence: the number of active S-boxes
those `r` rounds pay for. Nothing here knows where the sequence came from. -/
def patternWeight (T : Nat → (Idx → K)) (r : Nat) : Nat :=
  ∑ i ∈ Finset.range r, weight (T i)

theorem patternWeight_add_four (T : Nat → (Idx → K)) (n : Nat) :
    patternWeight T (n + 4) = patternWeight T n
      + (weight (T n) + weight (T (n + 1)) + weight (T (n + 2)) + weight (T (n + 3))) := by
  have e3 : patternWeight T (n + 4)
      = patternWeight T (n + 3) + weight (T (n + 3)) := Finset.sum_range_succ _ _
  have e2 : patternWeight T (n + 3)
      = patternWeight T (n + 2) + weight (T (n + 2)) := Finset.sum_range_succ _ _
  have e1 : patternWeight T (n + 2)
      = patternWeight T (n + 1) + weight (T (n + 1)) := Finset.sum_range_succ _ _
  have e0 : patternWeight T (n + 1)
      = patternWeight T n + weight (T n) := Finset.sum_range_succ _ _
  omega

theorem patternWeight_add_two (T : Nat → (Idx → K)) (n : Nat) :
    patternWeight T (n + 2) = patternWeight T n + (weight (T n) + weight (T (n + 1))) := by
  have e1 : patternWeight T (n + 2)
      = patternWeight T (n + 1) + weight (T (n + 1)) := Finset.sum_range_succ _ _
  have e0 : patternWeight T (n + 1)
      = patternWeight T n + weight (T n) := Finset.sum_range_succ _ _
  omega

theorem patternWeight_mono (T : Nat → (Idx → K)) {r r' : Nat} (h : r ≤ r') :
    patternWeight T r ≤ patternWeight T r' :=
  Finset.sum_le_sum_of_subset (Finset.range_subset_range.mpr h)

end PatternWeight

namespace WideTrailSpec

variable {Idx Col K : Type*} [Zero K] [DecidableEq K] [Fintype Idx] [DecidableEq Idx]
  [DecidableEq Col] [Fintype Col]

/-- The linear layer of a round, `λ = θ ∘ π`. It is everything in the round that is a
function of the difference. -/
def lin (S : WideTrailSpec Idx Col K) (b : Idx → K) : Idx → K :=
  S.mix (transpose S.disp b)

/-- The round transformation `ρᶜ = θ ∘ π ∘ γ`. -/
def round (S : WideTrailSpec Idx Col K) (a : Idx → K) : Idx → K :=
  S.mix (transpose S.disp (S.sbox a))

/-- The sequence of difference (or selection) patterns at the input of each round. -/
def trail (S : WideTrailSpec Idx Col K) (a : Idx → K) : Nat → (Idx → K)
  | 0 => a
  | n + 1 => S.round (trail S a n)

/-- The bundle weight of the first `r` rounds of a trail: the number of active S-boxes. -/
def trailWeight (S : WideTrailSpec Idx Col K) (a : Idx → K) (r : Nat) : Nat :=
  patternWeight (S.trail a) r

/-- The four-round active-S-box bound of this specification. -/
def fourRoundBound (S : WideTrailSpec Idx Col K) : Nat := S.branch * S.branch

variable (S : WideTrailSpec Idx Col K)

theorem round_apply (a : Idx → K) :
    S.round a = S.mix (transpose S.disp (S.sbox a)) := rfl

theorem round_eq_lin (a : Idx → K) : S.round a = S.lin (S.sbox a) := rfl

@[simp] theorem trail_zero (a : Idx → K) : S.trail a 0 = a := rfl

@[simp] theorem trail_succ (a : Idx → K) (n : Nat) :
    S.trail a (n + 1) = S.round (S.trail a n) := rfl

theorem lin_ne_zero {b : Idx → K} (hb : b ≠ 0) : S.lin b ≠ 0 :=
  fun h => (supportPerm_transpose S.disp).ne_zero hb (S.mix_nondeg _ h)

/-- The linear layer of a round is invertible, since `θ` is and `π` is a relabelling. -/
theorem lin_nondeg : NonDegenerate S.lin :=
  fun _ h => not_not.mp (fun hb => S.lin_ne_zero hb h)

theorem round_ne_zero {a : Idx → K} (ha : a ≠ 0) : S.round a ≠ 0 :=
  S.lin_ne_zero (ne_zero_of_preservesSupport S.sbox_preserves ha)

theorem trail_ne_zero {a : Idx → K} (ha : a ≠ 0) (n : Nat) : S.trail a n ≠ 0 := by
  induction n with
  | zero => exact ha
  | succ n ih => exact S.round_ne_zero ih

/-! ### Pattern sequences a cipher can exhibit

`IsTrail S T r` says that the first `r` steps of the sequence `T` are steps this cipher can
take: `T (n+1)` is the linear layer applied to some pattern carrying the support of `T n`.
The S-box layer contributes exactly that support constraint and nothing else, so this is the
weakest hypothesis under which the count below is true, and it is what a real differential
trail satisfies. -/

/-- The first `r` steps of `T` are steps of `S`. -/
def IsTrail (S : WideTrailSpec Idx Col K) (T : Nat → (Idx → K)) (r : Nat) : Prop :=
  ∀ n < r, ∃ b, activePattern b = activePattern (T n) ∧ T (n + 1) = S.lin b

/-- The functional trail is a trail. -/
theorem isTrail_trail (a : Idx → K) (r : Nat) : S.IsTrail (S.trail a) r :=
  fun n _ => ⟨S.sbox (S.trail a n), S.sbox_preserves _, rfl⟩

variable {S}

theorem IsTrail.mono {T : Nat → (Idx → K)} {r r' : Nat} (hT : S.IsTrail T r) (h : r' ≤ r) :
    S.IsTrail T r' := fun n hn => hT n (lt_of_lt_of_le hn h)

theorem IsTrail.ne_zero {T : Nat → (Idx → K)} {r : Nat} (hT : S.IsTrail T r) (h0 : T 0 ≠ 0) :
    ∀ n ≤ r, T n ≠ 0 := by
  intro n
  induction n with
  | zero => intro _; exact h0
  | succ n ih =>
    intro hn
    obtain ⟨b, hb, he⟩ := hT n (by omega)
    rw [he]
    exact S.lin_ne_zero (ne_zero_congr hb (ih (by omega)))

/-- Theorem 1, for a trail of this cipher. -/
theorem IsTrail.two_round {T : Nat → (Idx → K)} {r : Nat} (hT : S.IsTrail T r) (h0 : T 0 ≠ 0)
    {n : Nat} (hn : n + 1 ≤ r) :
    S.branch ≤ weight (T n) + weight (T (n + 1)) := by
  obtain ⟨b, hb, he⟩ := hT n (by omega)
  exact two_round_pattern (supportPerm_transpose S.disp) S.mix_branch
    (hT.ne_zero h0 n (by omega)) hb he

/-- Theorem 3, for a trail of this cipher. -/
theorem IsTrail.four_round {T : Nat → (Idx → K)} {r : Nat} (hT : S.IsTrail T r) (h0 : T 0 ≠ 0)
    {n : Nat} (hn : n + 3 ≤ r) :
    S.fourRoundBound ≤ weight (T n) + weight (T (n + 1))
      + weight (T (n + 2)) + weight (T (n + 3)) := by
  obtain ⟨b₁, hb₁, e₂⟩ := hT n (by omega)
  obtain ⟨b₂, hb₂, e₃⟩ := hT (n + 1) (by omega)
  obtain ⟨b₃, hb₃, e₄⟩ := hT (n + 2) (by omega)
  exact four_round_pattern (supportPerm_transpose S.disp) S.disp_optimal S.mix_branch
    S.mix_nondeg (hT.ne_zero h0 n (by omega)) hb₁ hb₂ hb₃ e₂ e₃ e₄

/-- Over `4n` rounds the active-S-box count is at least `n` times the four-round bound.
The paper states the analogous decomposition only for two-round blocks. -/
theorem IsTrail.bound {T : Nat → (Idx → K)} {r : Nat} (hT : S.IsTrail T r) (h0 : T 0 ≠ 0) :
    ∀ n, 4 * n ≤ r → n * S.fourRoundBound ≤ patternWeight T (4 * n) := by
  intro n
  induction n with
  | zero => intro _; simp [patternWeight]
  | succ n ih =>
    intro hn
    have hstep := hT.four_round h0 (n := 4 * n) (by omega)
    have hih := ih (by omega)
    have hsplit : 4 * (n + 1) = 4 * n + 4 := by omega
    rw [hsplit, patternWeight_add_four]
    have hmul : (n + 1) * S.fourRoundBound
        = n * S.fourRoundBound + S.fourRoundBound := Nat.succ_mul n S.fourRoundBound
    omega

/-- Over `4n + 2` rounds the count is at least `n · B² + B`: `n` four-round blocks, plus
one two-round block on the two rounds the block tiling leaves over. -/
theorem IsTrail.bound_add_two {T : Nat → (Idx → K)} {r : Nat} (hT : S.IsTrail T r)
    (h0 : T 0 ≠ 0) (n : Nat) (hn : 4 * n + 2 ≤ r) :
    n * S.fourRoundBound + S.branch ≤ patternWeight T (4 * n + 2) := by
  have hblocks := hT.bound h0 n (by omega)
  have htail := hT.two_round h0 (n := 4 * n) (by omega)
  rw [patternWeight_add_two]
  omega

/-- **The bound for an arbitrary number of rounds.** `r / 4` four-round blocks, plus one
two-round block whenever at least two rounds are left over. Every concrete round count in
this development is this theorem evaluated at a numeral. -/
theorem IsTrail.bound_rounds {T : Nat → (Idx → K)} {r : Nat} (hT : S.IsTrail T r)
    (h0 : T 0 ≠ 0) :
    r / 4 * S.fourRoundBound + (if 2 ≤ r % 4 then S.branch else 0) ≤ patternWeight T r := by
  split
  · next h =>
      exact le_trans (hT.bound_add_two h0 (r / 4) (by omega)) (patternWeight_mono T (by omega))
  · next h =>
      rw [Nat.add_zero]
      exact le_trans (hT.bound h0 (r / 4) (by omega)) (patternWeight_mono T (by omega))

variable (S)

/-! ### The functional trail

Each statement below is the corresponding `IsTrail` statement at `T = S.trail a`, where the
S-box layer is the fixed map `S.sbox`. -/

/-- Two consecutive rounds of a wide-trail cipher already cost `branch` active S-boxes. -/
theorem two_round {a : Idx → K} (ha : a ≠ 0) (n : Nat) :
    S.branch ≤ weight (S.trail a n) + weight (S.trail a (n + 1)) :=
  (S.isTrail_trail a (n + 1)).two_round ha (le_refl _)

/-- **The four-round bound.** Any four consecutive rounds of a wide-trail cipher contain
at least `branch²` active S-boxes. -/
theorem four_round {a : Idx → K} (ha : a ≠ 0) (n : Nat) :
    S.fourRoundBound ≤ weight (S.trail a n) + weight (S.trail a (n + 1))
      + weight (S.trail a (n + 2)) + weight (S.trail a (n + 3)) :=
  (S.isTrail_trail a (n + 3)).four_round ha (le_refl _)

theorem trailWeight_add_four (a : Idx → K) (n : Nat) :
    S.trailWeight a (n + 4) = S.trailWeight a n
      + (weight (S.trail a n) + weight (S.trail a (n + 1))
        + weight (S.trail a (n + 2)) + weight (S.trail a (n + 3))) :=
  patternWeight_add_four (S.trail a) n

theorem trailWeight_add_two (a : Idx → K) (n : Nat) :
    S.trailWeight a (n + 2) = S.trailWeight a n
      + (weight (S.trail a n) + weight (S.trail a (n + 1))) :=
  patternWeight_add_two (S.trail a) n

theorem trailWeight_mono (a : Idx → K) {r r' : Nat} (h : r ≤ r') :
    S.trailWeight a r ≤ S.trailWeight a r' :=
  patternWeight_mono (S.trail a) h

theorem trailWeight_bound {a : Idx → K} (ha : a ≠ 0) (n : Nat) :
    n * S.fourRoundBound ≤ S.trailWeight a (4 * n) :=
  (S.isTrail_trail a (4 * n)).bound ha n (le_refl _)

/-! ### The leftover rounds

`trailWeight_bound` tiles a trail with disjoint four-round blocks and abandons whatever
does not fit. Up to three rounds can be abandoned, and the last two of them are still a
two-round block, so Theorem 1 still charges `branch` for them. The blocks and the tail
sit on disjoint round ranges, so the two bounds simply add.

This is the whole content of the sharpening. It is stated at the level of
`WideTrailSpec`, so every instantiation downstream inherits it. -/

theorem trailWeight_bound_add_two {a : Idx → K} (ha : a ≠ 0) (n : Nat) :
    n * S.fourRoundBound + S.branch ≤ S.trailWeight a (4 * n + 2) :=
  (S.isTrail_trail a (4 * n + 2)).bound_add_two ha n (le_refl _)

theorem trailWeight_bound_rounds {a : Idx → K} (ha : a ≠ 0) (r : Nat) :
    r / 4 * S.fourRoundBound + (if 2 ≤ r % 4 then S.branch else 0)
      ≤ S.trailWeight a r :=
  (S.isTrail_trail a r).bound_rounds ha

end WideTrailSpec
